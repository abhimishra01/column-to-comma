---
// The tool. Logic lives in src/lib/convert.js (tested by npm test). This file is markup plus event wiring.
const chip = 'rounded-full border border-edge bg-card px-3.5 min-h-10 text-sm font-medium text-ink hover:border-brand focus-visible:border-brand disabled:cursor-default disabled:opacity-45 disabled:hover:border-edge';
const smallBtn = 'inline-flex min-h-10 items-center rounded-lg border border-edge bg-card px-3 text-sm font-medium text-ink hover:border-brand';
const field = 'mt-1 block min-h-11 w-full rounded-lg border border-edge bg-paper px-3 text-base text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 disabled:opacity-45';
const check = 'flex min-h-11 cursor-pointer items-center gap-3 rounded-lg px-1 text-[0.95rem] has-[:disabled]:cursor-default has-[:disabled]:opacity-45';
const box = 'h-5 w-5 shrink-0 accent-[var(--brand)]';
// Landing pages pass a preset: the settings that differ from the defaults, plus an example for the Example button.
const { config = null, example = '' } = Astro.props;
---
<section id="tool" aria-label="Column to comma converter" data-config={config ? JSON.stringify({ ...config, example }) : undefined} class="rounded-2xl border border-line bg-card shadow-[var(--card-shadow)] p-3 sm:p-5">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <fieldset class="m-0 min-w-0 border-0 p-0">
      <legend class="sr-only">Direction</legend>
      <div class="inline-flex rounded-xl border border-line bg-paper p-1" id="mode-group">
        <label class="seg"><input type="radio" name="mode" value="toList" checked class="sr-only" /><span>Column to list</span></label>
        <label class="seg"><input type="radio" name="mode" value="toColumn" class="sr-only" /><span>List to column</span></label>
      </div>
    </fieldset>
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Quick settings">
      <span class="text-sm text-muted">Quick:</span>
      <button type="button" class={chip} data-preset="comma">Comma list</button>
      <button type="button" class={chip} data-preset="sql">SQL IN list</button>
      <button type="button" class={chip} data-preset="json">JSON array</button>
      <button type="button" class={chip} data-preset="csv">CSV row</button>
    </div>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2 lg:grid-rows-[auto_1fr]">
    <div class="order-1 lg:col-start-1 lg:row-start-1">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <label for="in" id="in-label" class="text-sm font-semibold">Your column</label>
        <div class="flex flex-wrap gap-2">
          <button type="button" id="paste" class={smallBtn}>Paste</button>
          <button type="button" id="upload" class={smallBtn}>Upload file</button>
          <input type="file" id="file" accept=".txt,.csv,.tsv,.text,text/plain,text/csv" class="sr-only" tabindex="-1" aria-label="Choose a .txt or .csv file" />
          <button type="button" id="example" class={smallBtn}>Example</button>
          <button type="button" id="clear" class={smallBtn}>Clear</button>
        </div>
      </div>
      <textarea id="in" spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" wrap="off"
        placeholder={'One value per line, for example:\n1001\n1002\n1003'}
        class="mt-2 block h-56 w-full resize-y rounded-xl border border-edge bg-paper p-3 font-mono text-[0.9375rem] leading-6 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 lg:h-64"></textarea>
    </div>

    <details id="opts" open class="order-3 lg:col-start-1 lg:row-start-2">
      <summary class="flex min-h-11 cursor-pointer items-center text-sm font-semibold lg:hidden">Options</summary>
      <h2 class="sr-only">Options</h2>
      <div class="grid grid-cols-2 gap-x-3 gap-y-1">
        <div>
          <label for="delim" id="delim-label" class="text-sm font-semibold">Separator</label>
          <select id="delim" class={field}>
            <option value="auto" hidden>Auto-detect</option>
            <option value="comma" selected>Comma ,</option>
            <option value="comma-space">Comma + space</option>
            <option value="semicolon">Semicolon ;</option>
            <option value="pipe">Pipe |</option>
            <option value="newline">New line</option>
            <option value="tab">Tab</option>
            <option value="space">Space</option>
            <option value="custom">Custom...</option>
          </select>
        </div>
        <div>
          <label for="custom" class="text-sm font-semibold">Custom text</label>
          <input id="custom" type="text" placeholder=" - " autocomplete="off" spellcheck="false" disabled class={field + ' font-mono'} />
        </div>
        <div>
          <label for="quote" class="text-sm font-semibold">Quotes</label>
          <select id="quote" class={field}>
            <option value="none">None</option>
            <option value="single">Single &#39;a&#39;</option>
            <option value="double">Double &quot;a&quot;</option>
            <option value="backtick">Backtick `a`</option>
            <option value="json">Double, JSON style &quot;a&quot;</option>
          </select>
        </div>
        <div>
          <label for="wrap" class="text-sm font-semibold">Wrap list</label>
          <select id="wrap" class={field}>
            <option value="none">None</option>
            <option value="parens">( ) parentheses</option>
            <option value="brackets">[ ] brackets</option>
            <option value="braces">&#123; &#125; braces</option>
          </select>
        </div>
        <div>
          <label for="sort" class="text-sm font-semibold">Sort</label>
          <select id="sort" class={field}>
            <option value="none">Keep order</option>
            <option value="az">A to Z</option>
            <option value="za">Z to A</option>
            <option value="num-asc">Numbers, small first</option>
            <option value="num-desc">Numbers, large first</option>
          </select>
        </div>
        <div>
          <label for="caps" class="text-sm font-semibold">Letter case</label>
          <select id="caps" class={field}>
            <option value="none">Keep as typed</option>
            <option value="upper">UPPER CASE</option>
            <option value="lower">lower case</option>
            <option value="title">Title Case</option>
          </select>
        </div>
        <div>
          <label for="itemPrefix" class="text-sm font-semibold">Before each item</label>
          <input id="itemPrefix" type="text" placeholder="&lt;li&gt;" autocomplete="off" spellcheck="false" class={field + ' font-mono'} />
        </div>
        <div>
          <label for="itemSuffix" class="text-sm font-semibold">After each item</label>
          <input id="itemSuffix" type="text" placeholder="&lt;/li&gt;" autocomplete="off" spellcheck="false" class={field + ' font-mono'} />
        </div>
        <div>
          <label for="listPrefix" class="text-sm font-semibold">Before the list</label>
          <input id="listPrefix" type="text" placeholder="&lt;ul&gt;\n" autocomplete="off" spellcheck="false" class={field + ' font-mono'} />
        </div>
        <div>
          <label for="listSuffix" class="text-sm font-semibold">After the list</label>
          <input id="listSuffix" type="text" placeholder="\n&lt;/ul&gt;" autocomplete="off" spellcheck="false" class={field + ' font-mono'} />
        </div>
      </div>
      <div class="mt-2 grid gap-x-3 sm:grid-cols-2">
        <label class={check}><input type="checkbox" id="trim" checked class={box} />Trim spaces</label>
        <label class={check}><input type="checkbox" id="blanks" checked class={box} />Remove blank lines</label>
        <label class={check}><input type="checkbox" id="dedupe" class={box} />Remove duplicates</label>
        <label class={check}><input type="checkbox" id="icase" class={box} />Ignore case for duplicates</label>
        <label class={check + ' sm:col-span-2'}><input type="checkbox" id="nums" class={box} />Do not quote numbers (good for SQL IN)</label>
        <label class={check + ' sm:col-span-2'}><input type="checkbox" id="firstCol" class={box} />Use only the first column when a row has tabs (Excel paste)</label>
      </div>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <button type="button" id="reset" class={smallBtn}>Reset options</button>
        <p id="saved" role="status" class="text-sm text-muted"></p>
      </div>
    </details>

    <div class="order-2 flex flex-col lg:col-start-2 lg:row-span-2 lg:row-start-1">
      <div class="flex items-end justify-between gap-2">
        <label for="out" id="out-label" class="text-sm font-semibold">Your list</label>
        <button type="button" id="copy" disabled aria-keyshortcuts="Control+Enter Meta+Enter"
          class="max-lg:hidden inline-flex min-h-11 items-center gap-2 rounded-lg bg-brand px-4 text-base font-semibold text-white hover:brightness-110 focus-visible:outline-offset-2 disabled:cursor-default disabled:opacity-45 disabled:hover:brightness-100">
          <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
          <span id="copy-label">Copy</span>
          <kbd id="copy-kbd" class="hidden rounded border border-white/40 px-1.5 py-0.5 font-sans text-xs font-medium text-white/90 lg:inline">Ctrl+Enter</kbd>
        </button>
      </div>
      <textarea id="out" readonly spellcheck="false" wrap="soft" placeholder="Your list shows up here as you type."
        class="mt-2 block h-56 w-full resize-y rounded-xl border border-edge bg-brand-soft p-3 font-mono text-[0.9375rem] leading-6 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 lg:h-auto lg:min-h-[22rem] lg:flex-1"></textarea>
      <div class="mt-2 flex flex-wrap items-start justify-between gap-2">
        <p id="stats" class="min-h-6 min-w-0 flex-1 whitespace-pre-line text-sm text-muted"></p>
        <button type="button" id="download" disabled class={smallBtn + ' disabled:cursor-default disabled:opacity-45 disabled:hover:border-edge'}>Download .txt</button>
      </div>
      <p id="announce" role="status" class="sr-only"></p>
    </div>
  </div>

</section>
<div id="bar" hidden class="fixed inset-x-0 bottom-0 z-20 border-t border-line bg-card/95 px-4 py-2 backdrop-blur lg:hidden" style="padding-bottom:max(0.5rem, env(safe-area-inset-bottom))">
  <button type="button" id="copy-bar" class="flex min-h-12 w-full items-center justify-center gap-2 rounded-lg bg-brand px-4 text-base font-semibold text-white">
    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
    <span id="copy-bar-label">Copy list</span>
  </button>
</div>
<script is:inline>
  // Runs before paint: on a phone the options start closed, so the result sits right under the input.
  if (matchMedia('(max-width: 1023px)').matches) document.getElementById('opts').open = false;
</script>

<style>
  .seg { position: relative; display: inline-flex; cursor: pointer; }
  .seg span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 0.9rem; border-radius: 0.6rem; font-size: 0.9375rem; font-weight: 600; color: var(--muted); }
  .seg:hover span { color: var(--ink); }
  .seg input:checked + span { background: var(--brand); color: #fff; }
  .seg input:focus-visible + span { outline: 2px solid var(--brand-ink); outline-offset: 2px; }
</style>

<script>
  import { convert, optsFromConfig, DEFAULT_CONFIG, PRESETS } from '../lib/convert.js';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = $<HTMLTextAreaElement>('in');
  const out = $<HTMLTextAreaElement>('out');
  const delim = $<HTMLSelectElement>('delim');
  const custom = $<HTMLInputElement>('custom');
  const quote = $<HTMLSelectElement>('quote');
  const wrap = $<HTMLSelectElement>('wrap');
  const sort = $<HTMLSelectElement>('sort');
  const trim = $<HTMLInputElement>('trim');
  const blanks = $<HTMLInputElement>('blanks');
  const dedupe = $<HTMLInputElement>('dedupe');
  const icase = $<HTMLInputElement>('icase');
  const nums = $<HTMLInputElement>('nums');
  const caps = $<HTMLSelectElement>('caps');
  const firstCol = $<HTMLInputElement>('firstCol');
  const itemPrefix = $<HTMLInputElement>('itemPrefix');
  const itemSuffix = $<HTMLInputElement>('itemSuffix');
  const listPrefix = $<HTMLInputElement>('listPrefix');
  const listSuffix = $<HTMLInputElement>('listSuffix');
  const saved = $('saved');
  const downloadBtn = $<HTMLButtonElement>('download');
  const fileInput = $<HTMLInputElement>('file');
  const bar = $('bar');
  const copyBar = $<HTMLButtonElement>('copy-bar');
  const copyBarLabel = $('copy-bar-label');
  const section = $('tool');
  // A landing page sets a preset. It wins over saved options, and it never overwrites them.
  const preset = section.dataset.config ? JSON.parse(section.dataset.config) : null;
  const copyBtn = $<HTMLButtonElement>('copy');
  const copyLabel = $('copy-label');
  const stats = $('stats');
  const announce = $('announce');
  const opts = $<HTMLDetailsElement>('opts');
  const presetBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-preset]'));
  const modes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="mode"]'));
  const autoOpt = delim.querySelector<HTMLOptionElement>('option[value="auto"]')!;

  const mac = /Mac|iPhone|iPad/.test((navigator as any).userAgentData?.platform ?? navigator.userAgent);
  const touch = matchMedia('(pointer: coarse)').matches;
  const KEY = 'ctc-options-v1';
  const mode = () => (modes.find((m) => m.checked)?.value ?? 'toList') as 'toList' | 'toColumn';

  // Every saved control, with its default. save, restore and reset all loop over this one table.
  const controls = { delim, custom, quote, wrap, sort, caps, trim, blanks, dedupe, icase, nums, firstCol, itemPrefix, itemSuffix, listPrefix, listSuffix };
  const DEFAULTS = DEFAULT_CONFIG as Record<string, string | boolean>;
  const isBox = (el: HTMLElement): el is HTMLInputElement => el instanceof HTMLInputElement && el.type === 'checkbox';

  // The separator belongs to the mode. Column to list remembers its choice; List to column starts on Auto.
  // Only the Column to list choice is saved, on purpose: Auto is the right start for a pasted list.
  const delimByMode = { toList: 'comma', toColumn: 'auto' };
  let currentMode = mode();

  // Safari ignores a hidden <option>, so Auto-detect is added to the menu only in List to column mode.
  function showAuto(rev: boolean) {
    if (rev && !autoOpt.isConnected) delim.prepend(autoOpt);
    if (!rev) autoOpt.remove();
  }

  function applyValues(v: Partial<Record<keyof typeof controls, unknown>>) {
    for (const [k, el] of Object.entries(controls)) {
      const key = k as keyof typeof controls;
      const val = v[key] ?? DEFAULTS[key];
      if (isBox(el)) el.checked = !!val; else (el as HTMLInputElement | HTMLSelectElement).value = String(val);
    }
    if (!delim.value) delim.value = 'comma';
  }

  // Tell the person once, ever, that their choices are kept on this device.
  function noteSaved() {
    try {
      if (localStorage.getItem(KEY + '-noted')) return;
      localStorage.setItem(KEY + '-noted', '1');
    } catch { return; }
    saved.textContent = 'Settings saved on this device.';
    setTimeout(() => (saved.textContent = ''), 3000);
  }

  function save() {
    if (preset) return;
    try {
      const v = readControls();
      v.delim = delimByMode.toList;
      localStorage.setItem(KEY, JSON.stringify(v));
    } catch { return; }
    noteSaved();
  }

  function syncUi() {
    const rev = mode() === 'toColumn';
    showAuto(rev);
    $('delim-label').textContent = rev ? 'Split on' : 'Separator';
    $('in-label').textContent = rev ? 'Your list' : 'Your column';
    $('out-label').textContent = rev ? 'Your column' : 'Your list';
    input.placeholder = rev ? "A list such as:\n'a', 'b', 'c'" : 'One value per line, for example:\n1001\n1002\n1003';
    out.placeholder = rev ? 'Your column shows up here as you type.' : 'Your list shows up here as you type.';
    quote.disabled = wrap.disabled = rev;
    [itemPrefix, itemSuffix, listPrefix, listSuffix, firstCol].forEach((el) => (el.disabled = rev));
    copyBarLabel.textContent = rev ? 'Copy column' : 'Copy list';
    presetBtns.forEach((b) => (b.disabled = rev));
    nums.disabled = rev || quote.value === 'none';
    icase.disabled = !dedupe.checked;
    custom.disabled = delim.value !== 'custom';
  }

  function readControls() {
    const v: Record<string, unknown> = { mode: mode() };
    for (const [k, el] of Object.entries(controls)) v[k] = isBox(el) ? el.checked : el.value;
    return v;
  }

  let timer = 0;
  function render() {
    const rev = mode() === 'toColumn';
    const text = input.value;
    const r = convert(text, optsFromConfig(readControls()));
    out.value = r.output;
    copyBtn.disabled = downloadBtn.disabled = r.output === '';
    bar.hidden = r.output === '';
    document.body.classList.toggle('has-bar', r.output !== '');
    const s = r.stats;
    const plural = (n: number, w: string) => `${n.toLocaleString('en-US')} ${w}${n === 1 ? '' : 's'}`;
    if (!text.trim()) { stats.textContent = ''; return; }
    const head = `${plural(s.outputItems, 'item')} from ${plural(s.inputItems, rev ? 'item' : 'line')}.`;
    const notes = [`${head} ${plural(s.blanksRemoved, 'blank')} removed, ${plural(s.duplicatesRemoved, 'duplicate')} removed.`];
    if (delim.value === 'custom' && !custom.value) notes.push('Type your custom separator. A comma is used until then.');
    if (s.multiColumn) notes.push('This looks like several columns. Tick "Use only the first column" in Options, or paste one column at a time.');
    if (s.tabsSplit) notes.push(`${plural(s.tabsSplit, 'row')} had more than one column. Only the first column is used.`);
    if (s.delimiterInItems) notes.push(`${plural(s.delimiterInItems, 'value')} contain the separator. Add quotes, or pick another separator.`);
    stats.textContent = notes.join('\n');
  }
  function schedule() {
    clearTimeout(timer);
    if (input.value.length > 200000) {
      stats.textContent = 'Working...';
      timer = window.setTimeout(render, 120);
    } else render();
  }
  function changed() { syncUi(); save(); schedule(); }

  let copyTimer = 0;
  async function copy() {
    if (copyBtn.disabled) return;
    const text = out.value;
    let ok = false;
    try { await navigator.clipboard.writeText(text); ok = true; } catch {}
    if (!ok) { out.focus(); out.select(); try { ok = document.execCommand('copy'); } catch {} }
    const label = ok ? 'Copied' : `Press ${mac ? 'Cmd' : 'Ctrl'}+C`;
    copyLabel.textContent = copyBarLabel.textContent = label;
    const msg = ok ? `Copied ${text.length.toLocaleString('en-US')} characters to the clipboard.` : `Copy was blocked. The text is selected, press ${mac ? 'Cmd' : 'Ctrl'}+C.`;
    stats.textContent = msg;
    announce.textContent = msg;
    clearTimeout(copyTimer);
    copyTimer = window.setTimeout(() => { copyLabel.textContent = 'Copy'; syncUi(); announce.textContent = ''; render(); }, 1600);
  }

  // events
  input.addEventListener('input', schedule);
  [delim, quote, wrap, sort, caps, trim, blanks, dedupe, icase, nums, firstCol].forEach((el) => el.addEventListener('change', () => {
    if (el === delim) {
      delimByMode[mode()] = delim.value;
      if (delim.value === 'custom') { syncUi(); custom.focus(); }
    }
    changed();
  }));
  [custom, itemPrefix, itemSuffix, listPrefix, listSuffix].forEach((el) => el.addEventListener('input', () => { save(); schedule(); }));
  modes.forEach((m) => m.addEventListener('change', () => {
    delimByMode[currentMode] = delim.value;
    currentMode = mode();
    showAuto(currentMode === 'toColumn');
    delim.value = delimByMode[currentMode];
    changed();
  }));
  presetBtns.forEach((b) => b.addEventListener('click', () => {
    const p = PRESETS[b.dataset.preset as keyof typeof PRESETS];
    delim.value = delimByMode.toList = p.delimiter;
    caps.value = 'none'; itemPrefix.value = itemSuffix.value = listPrefix.value = listSuffix.value = '';
    quote.value = p.quote; wrap.value = p.wrap; nums.checked = p.skipNumberQuotes;
    changed();
  }));
  $('reset').addEventListener('click', () => {
    modes[0].checked = true;
    currentMode = 'toList';
    delimByMode.toList = 'comma';
    applyValues({});
    changed();
  });
  $('clear').addEventListener('click', () => { input.value = ''; input.focus(); schedule(); });
  $('example').addEventListener('click', () => {
    input.value = preset?.example || (mode() === 'toColumn' ? "'1001', '1002', '1003', '1002', '1004'" : '1001\n1002\n1003\n1002\n\n1004\n  1005  ');
    schedule();
  });
  $('paste').addEventListener('click', async () => {
    try { input.value = await navigator.clipboard.readText(); schedule(); }
    catch {
      input.focus();
      stats.textContent = touch
        ? 'Your browser blocked the Paste button. Press and hold in the box, then tap Paste.'
        : `Your browser blocked the Paste button. Press ${mac ? 'Cmd' : 'Ctrl'}+V in the box instead.`;
    }
  });
  copyBtn.addEventListener('click', copy);
  copyBar.addEventListener('click', copy);
  $('upload').addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', async () => {
    const f = fileInput.files?.[0];
    fileInput.value = '';
    if (!f) return;
    try { input.value = await f.text(); schedule(); }
    catch { stats.textContent = 'This file could not be read. Try a .txt or .csv file.'; }
  });
  downloadBtn.addEventListener('click', () => {
    if (!out.value) return;
    const url = URL.createObjectURL(new Blob([out.value], { type: 'text/plain;charset=utf-8' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = mode() === 'toColumn' ? 'column.txt' : 'list.txt';
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });
  out.addEventListener('focus', () => out.select());
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); copy(); }
  });
  if (mac) $('copy-kbd').textContent = '⌘+Enter';
  // The options are always open on wide screens, where the summary is hidden.
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) opts.open = true; });

  // restore saved options
  try {
    const s = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (s) {
      if (s.mode === 'toColumn') { modes[1].checked = true; currentMode = 'toColumn'; }
      delimByMode.toList = s.delim && s.delim !== 'auto' ? s.delim : 'comma';
      applyValues({ ...s, delim: delimByMode.toList });
      if (currentMode === 'toColumn') { showAuto(true); delim.value = 'auto'; }
    }
  } catch {}
  if (preset) {
    const { example: _e, ...p } = preset;
    const rev = p.mode === 'toColumn';
    if (rev) { modes[1].checked = true; currentMode = 'toColumn'; showAuto(true); } else { modes[0].checked = true; currentMode = 'toList'; showAuto(false); }
    applyValues({ ...p, delim: p.delim ?? (rev ? 'auto' : 'comma') });
    delimByMode[currentMode] = delim.value;
  }
  syncUi();
  render();
</script>
