---
// The tool. Logic lives in src/lib/convert.js (tested by npm test). This file is markup plus event wiring.
const chip = 'rounded-full border border-line bg-card px-3.5 min-h-10 text-sm font-medium text-ink hover:border-brand focus-visible:border-brand';
const smallBtn = 'inline-flex min-h-10 items-center rounded-lg border border-line bg-card px-3 text-sm font-medium text-ink hover:border-brand';
const field = 'mt-1 block min-h-11 w-full rounded-lg border border-line bg-paper px-3 text-base text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 disabled:opacity-45';
const check = 'flex min-h-11 cursor-pointer items-center gap-3 rounded-lg px-1 text-[0.95rem] has-[:disabled]:cursor-default has-[:disabled]:opacity-45';
const box = 'h-5 w-5 shrink-0 accent-[var(--brand)]';
---
<section id="tool" aria-label="Column to comma converter" class="rounded-2xl border border-line bg-card p-3 sm:p-5">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <fieldset class="m-0 min-w-0 border-0 p-0">
      <legend class="sr-only">Direction</legend>
      <div class="inline-flex rounded-xl border border-line bg-paper p-1" id="mode-group">
        <label class="seg"><input type="radio" name="mode" value="toList" checked class="sr-only" /><span>Column to list</span></label>
        <label class="seg"><input type="radio" name="mode" value="toColumn" class="sr-only" /><span>List to column</span></label>
      </div>
    </fieldset>
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Quick settings">
      <span class="text-sm text-muted">Quick:</span>
      <button type="button" class={chip} data-preset="comma">Comma list</button>
      <button type="button" class={chip} data-preset="sql">SQL IN list</button>
      <button type="button" class={chip} data-preset="json">JSON array</button>
      <button type="button" class={chip} data-preset="csv">CSV row</button>
    </div>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2 lg:grid-rows-[auto_1fr]">
    <div class="lg:col-start-1 lg:row-start-1">
      <div class="flex items-end justify-between gap-2">
        <label for="in" id="in-label" class="text-sm font-semibold">Your column</label>
        <div class="flex gap-2">
          <button type="button" id="paste" class={smallBtn}>Paste</button>
          <button type="button" id="example" class={smallBtn}>Example</button>
          <button type="button" id="clear" class={smallBtn}>Clear</button>
        </div>
      </div>
      <textarea id="in" spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" wrap="off"
        placeholder={'One value per line, for example:\n1001\n1002\n1003'}
        class="mt-2 block h-56 w-full resize-y rounded-xl border border-line bg-paper p-3 font-mono text-[0.9375rem] leading-6 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 lg:h-64"></textarea>
    </div>

    <div class="lg:col-start-1 lg:row-start-2">
      <h2 class="sr-only">Options</h2>
      <div class="grid grid-cols-2 gap-x-3 gap-y-1">
        <div>
          <label for="delim" id="delim-label" class="text-sm font-semibold">Separator</label>
          <select id="delim" class={field}>
            <option value="auto" hidden>Auto-detect</option>
            <option value="comma" selected>Comma  ,</option>
            <option value="comma-space">Comma + space</option>
            <option value="semicolon">Semicolon  ;</option>
            <option value="pipe">Pipe  |</option>
            <option value="newline">New line</option>
            <option value="tab">Tab</option>
            <option value="space">Space</option>
            <option value="custom">Custom...</option>
          </select>
        </div>
        <div>
          <label for="custom" class="text-sm font-semibold">Custom text</label>
          <input id="custom" type="text" placeholder=" - " autocomplete="off" spellcheck="false" disabled class={field + ' font-mono'} />
        </div>
        <div>
          <label for="quote" class="text-sm font-semibold">Quotes</label>
          <select id="quote" class={field}>
            <option value="none">None</option>
            <option value="single">Single  &#39;a&#39;</option>
            <option value="double">Double  &quot;a&quot;</option>
            <option value="backtick">Backtick  `a`</option>
          </select>
        </div>
        <div>
          <label for="wrap" class="text-sm font-semibold">Wrap list</label>
          <select id="wrap" class={field}>
            <option value="none">None</option>
            <option value="parens">( ) parentheses</option>
            <option value="brackets">[ ] brackets</option>
            <option value="braces">&#123; &#125; braces</option>
          </select>
        </div>
        <div class="col-span-2">
          <label for="sort" class="text-sm font-semibold">Sort</label>
          <select id="sort" class={field}>
            <option value="none">Keep order</option>
            <option value="az">A to Z</option>
            <option value="za">Z to A</option>
            <option value="num-asc">Numbers, small first</option>
            <option value="num-desc">Numbers, large first</option>
          </select>
        </div>
      </div>
      <div class="mt-2 grid gap-x-3 sm:grid-cols-2">
        <label class={check}><input type="checkbox" id="trim" checked class={box} />Trim spaces</label>
        <label class={check}><input type="checkbox" id="blanks" checked class={box} />Remove blank lines</label>
        <label class={check}><input type="checkbox" id="dedupe" class={box} />Remove duplicates</label>
        <label class={check}><input type="checkbox" id="icase" class={box} />Ignore case for duplicates</label>
        <label class={check + ' sm:col-span-2'}><input type="checkbox" id="nums" class={box} />Do not quote numbers (good for SQL IN)</label>
      </div>
    </div>

    <div class="flex flex-col lg:col-start-2 lg:row-span-2 lg:row-start-1">
      <div class="flex items-end justify-between gap-2">
        <label for="out" id="out-label" class="text-sm font-semibold">Comma separated list</label>
        <button type="button" id="copy" disabled
          class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-brand px-4 text-base font-semibold text-white hover:brightness-110 focus-visible:outline-offset-2 disabled:cursor-default disabled:opacity-45 disabled:hover:brightness-100">
          <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
          <span id="copy-label">Copy</span>
          <kbd id="copy-kbd" class="hidden rounded border border-white/40 px-1.5 py-0.5 font-sans text-xs font-medium text-white/90 lg:inline">Ctrl+Enter</kbd>
        </button>
      </div>
      <textarea id="out" readonly spellcheck="false" wrap="soft" placeholder="Your list shows up here as you type."
        class="mt-2 block h-56 w-full resize-y rounded-xl border border-line bg-brand-soft p-3 font-mono text-[0.9375rem] leading-6 text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 lg:h-auto lg:min-h-[22rem] lg:flex-1"></textarea>
      <p id="stats" role="status" aria-live="polite" aria-atomic="true" class="mt-2 min-h-6 text-sm text-muted"></p>
    </div>
  </div>

</section>

<style>
  .seg { position: relative; display: inline-flex; cursor: pointer; }
  .seg span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 0.9rem; border-radius: 0.6rem; font-size: 0.9375rem; font-weight: 600; color: var(--muted); }
  .seg:hover span { color: var(--ink); }
  .seg input:checked + span { background: var(--brand); color: #fff; }
  .seg input:focus-visible + span { outline: 2px solid var(--brand-ink); outline-offset: 2px; }
  button:focus-visible, select:focus-visible, input:focus-visible { outline-offset: 2px; }
</style>

<script>
  import { convert, resolveDelimiter } from '../lib/convert.js';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = $<HTMLTextAreaElement>('in');
  const out = $<HTMLTextAreaElement>('out');
  const delim = $<HTMLSelectElement>('delim');
  const custom = $<HTMLInputElement>('custom');
  const quote = $<HTMLSelectElement>('quote');
  const wrap = $<HTMLSelectElement>('wrap');
  const sort = $<HTMLSelectElement>('sort');
  const trim = $<HTMLInputElement>('trim');
  const blanks = $<HTMLInputElement>('blanks');
  const dedupe = $<HTMLInputElement>('dedupe');
  const icase = $<HTMLInputElement>('icase');
  const nums = $<HTMLInputElement>('nums');
  const copyBtn = $<HTMLButtonElement>('copy');
  const copyLabel = $('copy-label');
  const stats = $('stats');
  const modes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="mode"]'));
  const autoOpt = delim.querySelector<HTMLOptionElement>('option[value="auto"]')!;

  const KEY = 'ctc-options-v1';
  let lastForwardDelim = 'comma';
  const mode = () => (modes.find((m) => m.checked)?.value ?? 'toList') as 'toList' | 'toColumn';

  const PRESETS: Record<string, Record<string, string | boolean>> = {
    comma: { delim: 'comma', quote: 'none', wrap: 'none', nums: false },
    sql: { delim: 'comma-space', quote: 'single', wrap: 'parens', nums: true },
    json: { delim: 'comma-space', quote: 'double', wrap: 'brackets', nums: true },
    csv: { delim: 'comma', quote: 'double', wrap: 'none', nums: false },
  };

  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify({
        mode: mode(), delim: mode() === 'toList' ? delim.value : lastForwardDelim, custom: custom.value, quote: quote.value, wrap: wrap.value, sort: sort.value,
        trim: trim.checked, blanks: blanks.checked, dedupe: dedupe.checked, icase: icase.checked, nums: nums.checked,
      }));
    } catch {}
  }

  function syncUi() {
    const rev = mode() === 'toColumn';
    autoOpt.hidden = !rev;
    $('delim-label').textContent = rev ? 'Split on' : 'Separator';
    $('in-label').textContent = rev ? 'Your list' : 'Your column';
    $('out-label').textContent = rev ? 'Column' : 'Comma separated list';
    input.placeholder = rev ? "A list such as:\n'a', 'b', 'c'" : 'One value per line, for example:\n1001\n1002\n1003';
    out.placeholder = rev ? 'Your column shows up here as you type.' : 'Your list shows up here as you type.';
    quote.disabled = wrap.disabled = rev;
    nums.disabled = rev || quote.value === 'none';
    icase.disabled = !dedupe.checked;
    custom.disabled = delim.value !== 'custom';
  }

  let timer = 0;
  function render() {
    const rev = mode() === 'toColumn';
    const text = input.value;
    const d = resolveDelimiter(delim.value, custom.value);
    const r = convert(text, {
      mode: mode(), delimiter: rev || d !== null ? d : ',', quote: quote.value, skipNumberQuotes: nums.checked,
      trim: trim.checked, removeBlanks: blanks.checked, dedupe: dedupe.checked, ignoreCase: icase.checked,
      sort: sort.value, wrap: wrap.value,
    });
    out.value = r.output;
    copyBtn.disabled = r.output === '';
    const s = r.stats;
    const plural = (n: number, w: string) => `${n.toLocaleString('en-US')} ${w}${n === 1 ? '' : 's'}`;
    if (!text.trim()) { stats.textContent = ''; return; }
    const parts = [`${plural(s.inputItems, rev ? 'item' : 'line')} in`, `${plural(s.outputItems, 'item')} out`];
    if (s.blanksRemoved) parts.push(`${plural(s.blanksRemoved, 'blank')} removed`);
    if (s.duplicatesRemoved) parts.push(`${plural(s.duplicatesRemoved, 'duplicate')} removed`);
    stats.textContent = parts.join('  |  ');
  }
  function schedule() {
    clearTimeout(timer);
    if (input.value.length > 200000) timer = window.setTimeout(render, 120);
    else render();
  }
  function changed() { syncUi(); save(); schedule(); }

  async function copy() {
    if (copyBtn.disabled) return;
    const text = out.value;
    let ok = false;
    try { await navigator.clipboard.writeText(text); ok = true; } catch {}
    if (!ok) { out.focus(); out.select(); try { ok = document.execCommand('copy'); } catch {} }
    copyLabel.textContent = ok ? 'Copied' : 'Press Ctrl+C';
    stats.textContent = ok ? `Copied ${out.value.length.toLocaleString('en-US')} characters to the clipboard.` : 'Copy was blocked. The text is selected, press Ctrl+C.';
    setTimeout(() => { copyLabel.textContent = 'Copy'; render(); }, 1600);
  }

  // events
  input.addEventListener('input', schedule);
  [delim, quote, wrap, sort, trim, blanks, dedupe, icase, nums].forEach((el) => el.addEventListener('change', () => {
    if (el === delim) {
      if (delim.value === 'custom') { syncUi(); custom.focus(); }
      if (mode() === 'toList') lastForwardDelim = delim.value;
    }
    changed();
  }));
  custom.addEventListener('input', () => { save(); schedule(); });
  modes.forEach((m) => m.addEventListener('change', () => {
    if (mode() === 'toColumn') { lastForwardDelim = delim.value === 'auto' ? lastForwardDelim : delim.value; delim.value = 'auto'; }
    else { delim.value = lastForwardDelim; }
    changed();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
    const p = PRESETS[b.dataset.preset!];
    modes[0].checked = true;
    delim.value = String(p.delim); lastForwardDelim = delim.value;
    quote.value = String(p.quote); wrap.value = String(p.wrap); nums.checked = Boolean(p.nums);
    changed();
  }));
  $('clear').addEventListener('click', () => { input.value = ''; input.focus(); schedule(); });
  $('example').addEventListener('click', () => {
    input.value = mode() === 'toColumn' ? "'1001', '1002', '1003', '1002', '1004'" : '1001\n1002\n1003\n1002\n\n1004\n  1005  ';
    schedule();
  });
  $('paste').addEventListener('click', async () => {
    try { input.value = await navigator.clipboard.readText(); schedule(); }
    catch { input.focus(); stats.textContent = 'Your browser blocked the paste button. Press Ctrl+V in the box instead.'; }
  });
  copyBtn.addEventListener('click', copy);
  out.addEventListener('focus', () => out.select());
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); copy(); }
  });
  if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) $('copy-kbd').textContent = '⌘+Enter';

  // restore saved options
  try {
    const s = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (s) {
      if (s.mode === 'toColumn') modes[1].checked = true;
      lastForwardDelim = s.delim && s.delim !== 'auto' ? s.delim : 'comma';
      delim.value = mode() === 'toColumn' ? 'auto' : lastForwardDelim;
      if (delim.value === '') delim.value = 'comma';
      custom.value = s.custom ?? ''; quote.value = s.quote ?? 'none'; wrap.value = s.wrap ?? 'none'; sort.value = s.sort ?? 'none';
      trim.checked = s.trim ?? true; blanks.checked = s.blanks ?? true; dedupe.checked = !!s.dedupe; icase.checked = !!s.icase; nums.checked = !!s.nums;
    }
  } catch {}
  syncUi();
  render();
</script>
