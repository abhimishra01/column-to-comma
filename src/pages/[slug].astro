---
// One landing page per search, built from src/data/pages.js. Same tool, preset settings, its own text.
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import AdSlot from '../components/AdSlot.astro';
import site from '../site.config.ts';
import { pages } from '../data/pages.js';
import { convert, optsFromConfig } from '../lib/convert.js';
import { withBase, withoutBase } from '../lib/url.ts';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const result = convert(page.example, optsFromConfig(page.config)).output;
const others = pages.filter((p) => p.slug !== page.slug);
const base = `https://${site.domain}`;
const url = new URL(withoutBase(Astro.url.pathname), base).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: `${base}/` },
      { '@type': 'ListItem', position: 2, name: page.title, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.title} description={page.description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-8 sm:pt-12">
    <h1 class="max-w-3xl text-3xl font-extrabold leading-[1.1] tracking-tight [text-wrap:balance] sm:text-5xl">{page.h1}</h1>
    <p class="mt-3 max-w-2xl text-base text-muted sm:text-lg">{page.intro}</p>
    <div class="mt-6"><Tool config={page.config} example={page.example} /></div>
    <AdSlot />
    <p class="mt-5 text-sm text-muted">Your text never leaves your browser. <a href={withBase('/privacy/')} class="underline underline-offset-4 hover:text-ink">Read how we handle data</a>.</p>
  </section>

  <section aria-labelledby="about-tool" class="mx-auto max-w-5xl px-4 pt-16">
    <article class="prose-site">
      <h2 id="about-tool" style="margin-top:0">Example</h2>
      <p>This input:</p>
      <pre class="overflow-x-auto rounded-xl border border-line bg-card p-4 font-mono text-sm leading-6"><code>{page.example.replaceAll('\t', '    ')}</code></pre>
      <p>gives this output with the settings on this page:</p>
      <pre class="overflow-x-auto rounded-xl border border-line bg-card p-4 font-mono text-sm leading-6"><code>{result}</code></pre>
      {page.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {s.p?.map((t) => <p>{t}</p>)}
          {s.ul && <ul>{s.ul.map((t) => <li>{t}</li>)}</ul>}
        </>
      ))}
    </article>
  </section>

  <section aria-labelledby="faq-h" class="mx-auto max-w-5xl px-4 pt-16">
    <h2 id="faq-h" class="text-2xl font-bold tracking-tight">Questions about this page</h2>
    <div class="mt-6 max-w-3xl divide-y divide-line border-y border-line">
      {page.faq.map((f) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg class="h-4 w-4 shrink-0 text-muted transition-transform group-open:rotate-45" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 2v12M2 8h12"/></svg>
          </summary>
          <p class="mt-2 text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section aria-labelledby="more-h" class="mx-auto max-w-5xl px-4 pt-16">
    <h2 id="more-h" class="text-2xl font-bold tracking-tight">More conversions</h2>
    <ul class="mt-4 grid list-none gap-x-6 gap-y-1 p-0 sm:grid-cols-2">
      <li><a href={withBase('/')} class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-ink">Column to comma separated list</a></li>
      {others.map((p) => <li><a href={withBase(`/${p.slug}/`)} class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-ink">{p.short}</a></li>)}
    </ul>
  </section>
</Base>
