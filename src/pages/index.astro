---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import Article from '../components/Article.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/Faq.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';
import { withBase } from '../lib/url.ts';
import { pages } from '../data/pages.js';

const base = `https://${site.domain}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    image: new URL(withBase(site.ogImage), Astro.site).href,
    featureList: 'Column to comma list, list to column, quotes, remove duplicates, sort, trim, SQL IN list',
    applicationCategory: site.category,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    author: { '@type': 'Person', name: 'Abhishek Mishra', jobTitle: 'Software Development Engineer', worksFor: { '@type': 'Organization', name: 'Oqu AI' }, url: 'https://bingemind.com/abhishek-mishra/' },
    publisher: { '@type': 'Organization', name: 'Bingemind', url: 'https://bingemind.com/' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-8 sm:pt-12">
    <h1 class="max-w-3xl text-3xl font-extrabold leading-[1.1] tracking-tight [text-wrap:balance] sm:text-5xl">
      Convert a column to a comma separated list
    </h1>
    <p class="mt-3 max-w-2xl text-base text-muted sm:text-lg">Paste your rows. The comma separated list, also called a column to CSV row, appears as you type. Add quotes, remove duplicates, sort, then copy.</p>
    <div class="mt-6"><Tool /></div>
    <AdSlot />
    <p class="mt-5 text-sm text-muted">Your text never leaves your browser. <a href={withBase('/privacy/')} class="underline underline-offset-4 hover:text-ink">Read how we handle data</a>.</p>
  </section>
  <Article />
  <Faq />
  <section aria-labelledby="more-h" class="mx-auto max-w-5xl px-4 pt-16">
    <h2 id="more-h" class="text-2xl font-bold tracking-tight">Popular conversions</h2>
    <ul class="mt-4 grid list-none gap-x-6 gap-y-1 p-0 sm:grid-cols-2">
      {pages.map((p) => <li><a href={withBase(`/${p.slug}/`)} class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-ink">{p.short}</a></li>)}
    </ul>
  </section>
</Base>
