---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import Article from '../components/Article.astro';
import Faq from '../components/Faq.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';

const base = `https://${site.domain}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    featureList: 'Column to comma list, list to column, quotes, remove duplicates, sort, trim, SQL IN list',
    applicationCategory: site.category,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-8 sm:pt-12">
    <h1 class="max-w-3xl text-3xl font-extrabold leading-[1.1] tracking-tight [text-wrap:balance] sm:text-5xl">
      Convert a column to a comma separated list
    </h1>
    <p class="mt-3 max-w-2xl text-base text-muted sm:text-lg">Paste your rows. The list appears as you type. Add quotes, remove duplicates, sort, then copy.</p>
    <div class="mt-6"><Tool /></div>
    <p class="mt-5 text-sm text-muted">Your text never leaves your browser. <a href="/privacy/" class="underline underline-offset-4 hover:text-ink">Read how we handle data</a>.</p>
  </section>
  <Article />
  <Faq />
</Base>
