---
import Page from '../layouts/Page.astro';
import site from '../site.config.ts';
import { withBase } from '../lib/url.ts';
---
<Page title="About" description="About Column to Comma, a free column to comma tool that runs in your browser. See what it does, how it works and why we built it.">
  <p>{site.name} turns a pasted column into a delimited list. People use it to build SQL IN lists, tidy values from Excel or Google Sheets, and move data between tools. It also works in reverse, from a list back to a column.</p>
  <h2>What it does</h2>
  <p>Paste a column and the list appears as you type. It handles lists of 100,000 rows.</p>
  <h2>How it works</h2>
  <p>The conversion runs in your browser. Your text is not uploaded and we do not ask you to create an account. You can add quotes, remove duplicates, sort, trim spaces and choose the separator.</p>
  <h2>Who made this</h2>
  <p>This tool was built by <a href="https://bingemind.com/abhishek-mishra/">Abhishek Mishra</a>, a software development engineer (SDE) at Oqu AI, and is published by Bingemind.</p>
  <p>Phone and WhatsApp: <a href="tel:+916376068337">+91 63760 68337</a> (<a href="https://wa.me/916376068337" rel="noopener">message on WhatsApp</a>).</p>
  <h2>Contact</h2>
  <p>Found a bug or want a feature? Write to <a href={site.contactHref}>{site.contactLabel}</a> or visit the <a href={withBase('/contact/')}>Contact page</a>.</p>
</Page>
